---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { site } from '../lib/site';

const url = Astro.site!.href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${url}#organization`,
    name: site.name,
    url,
    logo: new URL('/apple-touch-icon.png', url).href,
    image: new URL('/og-image.jpg', url).href,
    description: site.metaDescription,
    email: site.email,
    telephone: site.telephone,
    areaServed: 'AU',
    knowsAbout: site.keywords,
    sameAs: [
      ...site.footer.follow.map(({ href }) => href),
      'https://www.facebook.com/mangochutneydesign',
      'https://x.com/mangochutneyau',
    ],
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Level 1/367c Magill Road',
      addressLocality: 'St Morris',
      addressRegion: 'SA',
      postalCode: '5068',
      addressCountry: 'AU',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${url}#website`,
    name: site.name,
    url,
    publisher: { '@id': `${url}#organization` },
  },
];
---

<BaseLayout theme="cobalt" footerTheme="hedgehog" schema={schema}>
  {/* One fade from cobalt behind the hero to white where the footer begins. */}
  <div class="fade" data-theme="cobalt">
    <Section
      theme="cobalt"
      pad={false}
      class="flex flex-col items-center gap-stack-xl bg-transparent pt-[calc(var(--spacing-hero-top)+var(--spacing-stack-xl))]"
    >
      <div class="flex flex-col items-center gap-stack-m text-center">
        <h1 class="text-display-m text-headline">
          Design and engineering for teams <br class="max-xl:hidden" />
          building world‑class products.
        </h1>
        <p class="text-body-l">New website coming soon.</p>
      </div>
      <div class="w-full" aria-label="Clients">
        <ClientLogos />
      </div>
    </Section>

    <ContactPanel />
  </div>
</BaseLayout>

<style>
  .fade {
    background-image: linear-gradient(var(--color-a2-cobalt) 45%, var(--color-white));
  }

  /* The contact form selections are cobalt. */
  :global(#contact) {
    --t-form-selected: var(--color-a2-cobalt);
    --t-form-selected-fg: var(--color-a2-cream);
  }
</style>
