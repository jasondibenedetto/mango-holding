---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { indexable, site } from '../lib/site';
import { cleanPath } from '../lib/url';

export interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description = site.metaDescription,
  image,
  imageAlt = site.name,
  type = 'website',
  noindex = false,
  schema,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(cleanPath(Astro.url), Astro.site);

const ogImage = image
  ? new URL(
      (await getImage({ src: image, width: 1200, height: 630, format: 'jpg' })).src,
      Astro.site,
    )
  : new URL('/og-image.jpg', Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{(noindex || !indexable) && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@mangochutneyau" />

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
