---
import { site } from '../lib/site';

const svgs = import.meta.glob<string>('../assets/clients/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const logos = site.clients.map((client) => {
  const { slug, name } = client;
  const boost = 'boost' in client ? client.boost : 1;
  const svg = svgs[`../assets/clients/${slug}.svg`];
  const [, , w, h] = svg
    .match(/viewBox="([^"]+)"/)![1]
    .split(/\s+/)
    .map(Number);
  const ratio = w / h;

  return {
    name,
    ratio: ratio.toFixed(3),
    scale: (ratio ** -0.45 * boost).toFixed(3),
    svg: svg.replace(/^<svg([^>]*?)\s(width|height)="[^"]*"\s(width|height)="[^"]*"/, '<svg$1'),
  };
});

const cardCount = 10;
const shown = logos.slice(0, cardCount);
const waiting = logos.slice(cardCount);
---

<ul
  data-logo-flip
  aria-label="Clients"
  class="logo-grid grid gap-gutter-tight [--magnet-px:var(--logo-magnet-px)] [--tilt-max:var(--logo-tilt-max)] [--tilt-shine:var(--logo-tilt-shine)]"
>
  {shown.map(({ name, ratio, scale, svg }) => (
    <li
      data-tilt
      class="bg-card rounded-m @container flex aspect-square items-center justify-center"
    >
      <span
        data-tilt-magnet
        role="img"
        aria-label={name}
        class="logo text-client-logo"
        style={{ '--r': ratio, '--s': scale }}
        set:html={svg}
      />
    </li>
  ))}
</ul>

{/* Clients off the grid wait here and flip in as the waves pass. */}
{waiting.map(({ name, ratio, scale, svg }) => (
  <template data-logo-waiting>
    <span
      data-tilt-magnet
      role="img"
      aria-label={name}
      class="logo text-client-logo"
      style={{ '--r': ratio, '--s': scale }}
      set:html={svg}
    />
  </template>
))}

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-logo-flip]').forEach((grid) => {
    const cards = [...grid.children] as HTMLElement[];
    const waiting = [...document.querySelectorAll<HTMLTemplateElement>('[data-logo-waiting]')].map(
      (t) => t.content.firstElementChild as HTMLElement,
    );
    const style = getComputedStyle(grid);
    // The CSS minifier may write 620ms as .62s, so read the unit too.
    const ms = (name: string) => {
      const value = style.getPropertyValue(name).trim();

      return parseFloat(value) * (value.endsWith('ms') ? 1 : 1000);
    };
    const every = ms('--logo-flip-every');
    const ripple = ms('--logo-flip-ripple');
    const half = ms('--logo-flip-speed') / 2;
    const busy = new Set<HTMLElement>();
    let paused = false;
    let visible = false;

    const flip = async (card: HTMLElement, next: HTMLElement, delay: number) => {
      busy.add(card);
      await new Promise((resolve) => setTimeout(resolve, delay));
      await card.animate(
        [
          { transform: 'perspective(600px) rotateX(0deg)' },
          { transform: 'perspective(600px) rotateX(90deg)' },
        ],
        { duration: half, easing: 'cubic-bezier(.55, 0, .8, .2)', fill: 'forwards' },
      ).finished;

      card.replaceChildren(next);
      card.getAnimations().forEach((a) => a.cancel());

      await card.animate(
        [
          { transform: 'perspective(600px) rotateX(-90deg)' },
          { transform: 'perspective(600px) rotateX(8deg)', offset: 0.8 },
          { transform: 'perspective(600px) rotateX(0deg)' },
        ],
        { duration: half * 1.3, easing: 'cubic-bezier(.2, .7, .2, 1)' },
      ).finished;
      busy.delete(card);
    };

    const wave = () => {
      if (paused || !visible || document.hidden || reduce.matches) {
        return;
      }

      // Smaller screens hide the last cards, so their logos wait with the rest.
      const shown = cards.filter((card) => card.checkVisibility());
      const hiddenLogos = cards
        .filter((card) => !shown.includes(card))
        .map((card) => card.firstElementChild as HTMLElement | null)
        .filter((logo) => logo && !waiting.includes(logo)) as HTMLElement[];

      waiting.push(...hiddenLogos);

      if (!busy.size) {
        shown
          .filter((card) => !card.firstElementChild)
          .forEach((card) => card.append(waiting.shift()!));
      }

      const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
      const start = Math.floor(Math.random() * shown.length);
      const ready = shown
        .map((card, i) => ({
          card,
          distance: Math.hypot(
            (i % cols) - (start % cols),
            Math.floor(i / cols) - Math.floor(start / cols),
          ),
        }))
        .filter(({ card }) => !busy.has(card))
        .sort((a, b) => a.distance - b.distance);

      // There are fewer waiting clients than cards, so each card takes the logo of one that turned before it.
      const logos = [...waiting, ...ready.map(({ card }) => card.firstElementChild as HTMLElement)];
      waiting.splice(0, waiting.length, ...logos.slice(ready.length));
      ready.forEach(({ card, distance }, i) => flip(card, logos[i], distance * ripple));
    };

    grid.addEventListener('pointerenter', () => (paused = true));
    grid.addEventListener('pointerleave', () => (paused = false));
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(grid);
    setInterval(wave, every);
  });
</script>

<style>
  .logo-grid {
    grid-template-columns: repeat(var(--logo-cols), minmax(0, 1fr));
  }

  .logo-grid > li:nth-child(n + 7) {
    display: none;

    @media (width >= 64rem) {
      &:nth-child(-n + 8) {
        display: flex;
      }
    }

    @media (width >= 80rem) {
      display: flex;
    }
  }

  .logo {
    aspect-ratio: var(--r);
    height: min(
      calc(var(--logo-size) * var(--s)),
      var(--logo-max-h),
      calc(var(--logo-max-w) / var(--r))
    );
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
