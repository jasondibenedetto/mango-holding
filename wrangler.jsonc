{
  "name": "mango-holding",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.ts",
  // Every deploy is production, so build it indexable
  "build": { "command": "PUBLIC_INDEXABLE=true npx astro build" },
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
